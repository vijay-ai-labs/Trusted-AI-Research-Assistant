# ─── Server-only keys (no VITE_ prefix — never sent to browser) ──────────────
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to version control.

OPENAI_API_KEY=sk-...your-key-here...
OPENALEX_API_KEY=your-openalex-key-here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Use * to allow all (not recommended for prod).
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Optional: local-dev fallback only ───────────────────────────────────────
# Used inside frontend services ONLY when the backend proxy is unreachable
# during local development (import.meta.env.DEV === true).
# Not needed when running with `npm run dev:full` (proxy is available).
# VITE_OPENAI_API_KEY=sk-...local-dev-only...
# VITE_OPENALEX_API_KEY=...local-dev-only...
